        <script><![CDATA[/** This script is executed before the Record is generated
* `current`- GlideRecord produced by Record Producer
* Don't use `current.update()` or `current.insert()` as the record is generated by Record Producer
* Don't use `current.setValue('sys_class_name', 'xxx')` as this will trigger reparent flow and can cause data loss
* Avoid `current.setAbortAction()` and generate a separate record
* Use `producer.var1` to access variables
*/

//Lets find our Person!
var person = "";
if (producer.symptoms_for == "someone_else") {
	person = producer.person;
} else {
	person = gs.getUserID();
}

current.adult = person;
current.guardian = gs.getUserID();

//gs.info(producer.symptom_list);
//Loop through and pull data
var symptomsArr = global.JSON.parse(producer.symptom_list);
for (i=0; i < symptomsArr.length; i++) {
	try{
		var SymHistgr = new GlideRecord("x_1527609_health_0_symptom_history");
		SymHistgr.newRecord();
		SymHistgr.person = person;
		SymHistgr.severity = symptomsArr[i].severity;
		SymHistgr.symptom_start = symptomsArr[i].symptom_start;
		SymHistgr.symptom_end = symptomsArr[i].symptom_end;
		SymHistgr.symptom = symptomsArr[i].symptom;
		SymHistgr.health_first_request = current.sys_id;
		SymHistgr.insert();
	}catch(err){}
}


// Add info message for the patient if they request an appointment. 
// If they do not request an appoint, send a message letting them know their symptom data was saved.

if(producer.appointment) {
	gs.addInfoMessage('Thank you for requesting an appointment! You will be contacted within 24 hours to setup your appointment.');
}else {
	gs.addInfoMessage('Your symptoms have been saved.');
}
]]></script>
